# =============================================================================
# pothole-verification — .gitignore
# =============================================================================

# Raw & processed datasets (large binaries — never commit)
data/raw/
!data/raw/.gitkeep
data/processed/
!data/processed/.gitkeep
data/annotated/*/images/
data/annotated/local/*/images/
*.cache
*.cache.npy

# Regeneratable model draft proposals & temporary staging
data/manifests/assisted_proposals.json
**/.tmp_candidates/

# Model weights and training runs (keep .meta.json provenance sidecars tracked)
*.pt
*.pth
*.onnx
*.engine
*.tflite
runs/
!runs/.gitkeep
!runs/detector/.gitkeep
!runs/verifier/.gitkeep
models/*/*
!models/.gitkeep
!models/detector/.gitkeep
!models/verifier/.gitkeep
!models/**/*.meta.json
weights/
checkpoints/

# Runtime results & local databases (keep concise Markdown/JSON reports committable)
results/predictions/
results/evaluations/
results/reports/*
!results/reports/.gitkeep
!results/reports/*.md
!results/reports/*.json
results/*.db
results/*.db-*
configs/dashboard_settings.json

# Python & virtual environments
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Secrets & environment variables
.env
.env.local
.env.*.local
!.env.example
secrets.yaml
secrets.yml
*.key
*.pem
.streamlit/secrets.toml

# Temporary / OS / IDE noise
*.part
*.tmp
*.temp
*.bak
*.log
*.dll
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
.agents/
.ipynb_checkpoints/
